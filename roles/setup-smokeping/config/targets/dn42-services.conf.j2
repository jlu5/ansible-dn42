    },
    'wiki-ng': {
        'asn': 0,
        'host': 'wiki-ng.dn42'
    },
    'whois': {
        'asn': 0,
        'desc': 'dn42 Whois',
        'host4': '172.22.0.43',
        'host6': 'fd42:d42:d42:43::1'
    },
    'neo_dns': {
        'asn': 0,
        'desc': 'NeoNetwork DNS',
        'host4': '10.127.255.54',
        'host6': 'fd10:127:53:53::'
    },
    'chaosvpn_index': {
        'asn': 64654,
        'desc': 'ChaosVPN Index',
        'host4': '172.31.2.1',
    },
    'hackint_irc': {
        'asn': 4242420101,
