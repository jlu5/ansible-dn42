{# Skip ourselves (h), already covered in anycast-dns section #}
{% set _delegation_servers = {
    'b': 4242422601,
    'i': 4242422189,
    'j': 4242420119,
    'k': 4242423914,
} %}
{% for dns_server_letter, asn in _delegation_servers.items() %}
{% set _ = dn42_dests.update({
    dns_server_letter + '_dns': {
        'asn': asn,
        'host': dns_server_letter + '.delegation-servers.dn42',
        'desc': dns_server_letter + '. DNS',
    }
}) %}
{% endfor -%}

{% for entry_name, entry in dn42_dests.items() | sort(attribute='1.asn') %}
{% set _host4 = entry.get('host') or entry.get('host4') %}
{% set _host6 = entry.get('host') or entry.get('host6') -%}

{% if _host4 %}
{{ helpers.smokeping_dn42_target(
    entry_name,
    _host4,
    entry.get('desc', _host4),
    entry.get('asn'),
    false,
    long_description=entry.get('desc'))
}}
{% endif -%}

{% if _host6 %}
{{ helpers.smokeping_dn42_target(
    entry_name + ('_v6' if _host4 else ''),
    _host6,
    entry.get('desc', _host6),
    entry.get('asn'),
    true,
    long_description=entry.get('desc'))
}}
{% endif %}
{% endfor %}
